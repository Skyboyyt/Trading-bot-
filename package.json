{
  "name": "trading-bot",
  "private": true,
  "description": "Senku's Solana memecoin research and paper-trading bot. Live trading is disabled.",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./apps/*\" build",
    "typecheck": "tsc -p tsconfig.json && pnpm -r typecheck",
    "lint": "eslint .",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "pnpm --filter @tb/web test:e2e",
    "test:all": "pnpm test && pnpm test:integration",
    "check:paper-safety": "tsx scripts/check-paper-safety.ts",
    "check": "pnpm typecheck && pnpm lint && pnpm check:paper-safety && pnpm test",
    "db:generate": "pnpm --filter @tb/db generate",
    "db:migrate": "pnpm --filter @tb/db migrate",
    "db:seed": "pnpm --filter @tb/db seed",
    "dev:api": "pnpm --filter @tb/api dev",
    "dev:worker": "pnpm --filter @tb/worker dev",
    "dev:web": "pnpm --filter @tb/web dev",
    "hash-password": "pnpm --filter @tb/api hash-password",
    "allowlist": "pnpm --filter @tb/worker allowlist"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tb/config": "workspace:*",
    "@tb/db": "workspace:*",
    "@tb/domain": "workspace:*",
    "@tb/execution-live": "workspace:*",
    "@tb/execution-paper": "workspace:*",
    "@tb/ledger": "workspace:*",
    "@tb/observability": "workspace:*",
    "@tb/providers": "workspace:*",
    "@tb/risk": "workspace:*",
    "@tb/screening": "workspace:*",
    "@tb/strategy": "workspace:*",
    "@types/node": "22.20.5",
    "bs58": "6.0.0",
    "drizzle-orm": "0.45.4",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "postgres": "3.4.9",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5"
  }
}
